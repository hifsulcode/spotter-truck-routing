# Copy to .env for local development. Every value has a working default;
# no API keys are required (all providers are free public endpoints).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: point at your own routing/weather servers.
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# OSRM_URL=https://router.project-osrm.org
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# PHOTON_URL=https://photon.komoot.io/api/
# CACHE_TIMEOUT_SECONDS=900
